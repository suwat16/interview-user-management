# HTTP server
SERVER_ADDR=127.0.0.1:8080
SERVER_SHUTDOWN_TIMEOUT=5s

# MongoDB. For an authenticated instance, include credentials in the URI.
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DATABASE=user_management
MONGO_COLLECTION=users
MONGO_STARTUP_TIMEOUT=10s
MONGO_CLEANUP_TIMEOUT=5s
MONGO_HEALTHCHECK_TIMEOUT=2s

# Generate a signing secret with: openssl rand -hex 32
JWT_SECRET=
JWT_ACCESS_TOKEN_LIFETIME=1h

# Optional bcrypt hash with cost 10. If set, wrap the hash in single quotes.
MISSING_USER_HASH=

# Background user count
USER_COUNT_INTERVAL=10s
USER_COUNT_TIMEOUT=5s
